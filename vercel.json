{
  "version": 2,
  "name": "edukas-keuangan-sekolah",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/edukas_aplikasi_keuangan_sekolah_multi_sekolah.html"
    },
    {
      "source": "/api/config",
      "destination": "/api/config.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}